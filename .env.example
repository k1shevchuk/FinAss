APP_MODE=polling
LOG_LEVEL=INFO
JSON_LOGS=true

TELEGRAM_BOT_TOKEN=8570864155:AAFr1yqbzp8_ZFsUkm83dWgBcYZZuFRuADY
WEBHOOK_SECRET_TOKEN=replace_me
BASE_URL=https://example.com

GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/google_service_account.json
# Alternative supported by google libraries:
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_service_account.json
# Optional workaround for Service Account with zero personal Drive quota:
# 1) Create a folder in your Google Drive
# 2) Share that folder with Service Account email as Editor
# 3) Put folder ID here
GOOGLE_DRIVE_PARENT_FOLDER_ID=

DB_DSN=sqlite+aiosqlite:///./data/app.db
# Prod example:
# DB_DSN=postgresql+asyncpg://expense:expense@postgres:5432/expense

REDIS_URL=redis://redis:6379/0

DEFAULT_CURRENCY=RUB
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_ROUNDING_MODE=HALF_UP

INVITE_TTL_SECONDS=3600
IDEMPOTENCY_TTL_SECONDS=3600
RATE_LIMIT_USER_PER_MIN=20
RATE_LIMIT_CHAT_PER_MIN=60
RATE_LIMIT_SCAN_PER_10MIN=5

QR_MAX_FILE_SIZE_BYTES=5242880
QR_MAX_PIXELS=12000000
QR_DECODE_TIMEOUT_SECONDS=5
TELEGRAM_DOWNLOAD_TIMEOUT_SECONDS=15

GOOGLE_API_RETRY_MAX_ATTEMPTS=5
GOOGLE_API_RETRY_BASE_DELAY_SECONDS=0.5
GOOGLE_API_RETRY_MAX_DELAY_SECONDS=10
CACHE_TTL_SECONDS=300
REPORT_CACHE_TTL_SECONDS=120

SENTRY_DSN=
