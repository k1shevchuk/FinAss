APP_MODE=webhook
LOG_LEVEL=INFO
JSON_LOGS=true

TELEGRAM_BOT_TOKEN=1234567890:replace_with_real_bot_token
WEBHOOK_SECRET_TOKEN=replace_with_long_random_secret
BASE_URL=https://bot.example.com

# Service account JSON must exist on VM host and be mounted into container as /run/secrets/google_service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/google_service_account.json
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_service_account.json

# PostgreSQL in docker-compose.prod.yml
DB_DSN=postgresql+asyncpg://expense:expense_change_me@postgres:5432/expense
REDIS_URL=redis://redis:6379/0

DEFAULT_CURRENCY=RUB
DEFAULT_TIMEZONE=Europe/Berlin
DEFAULT_ROUNDING_MODE=HALF_UP

INVITE_TTL_SECONDS=3600
IDEMPOTENCY_TTL_SECONDS=3600
RATE_LIMIT_USER_PER_MIN=20
RATE_LIMIT_CHAT_PER_MIN=60
RATE_LIMIT_SCAN_PER_10MIN=5

QR_MAX_FILE_SIZE_BYTES=5242880
QR_MAX_PIXELS=12000000
QR_DECODE_TIMEOUT_SECONDS=5
TELEGRAM_DOWNLOAD_TIMEOUT_SECONDS=15

# Optional receipt provider
RECEIPT_ITEMS_PROVIDER=none
# RECEIPT_ITEMS_PROVIDER=proverkacheka
# RECEIPT_PROVIDER_API_TOKEN=your_token_here
RECEIPT_PROVIDER_API_TOKEN=
RECEIPT_PROVIDER_BASE_URL=https://proverkacheka.com
RECEIPT_PROVIDER_TIMEOUT_SECONDS=15

GOOGLE_API_RETRY_MAX_ATTEMPTS=7
GOOGLE_API_RETRY_BASE_DELAY_SECONDS=0.7
GOOGLE_API_RETRY_MAX_DELAY_SECONDS=20
CACHE_TTL_SECONDS=300
REPORT_CACHE_TTL_SECONDS=120

SENTRY_DSN=

# Used by postgres service in docker-compose.prod.yml
POSTGRES_DB=expense
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense_change_me
